{
  "name": "@workspace/mctiers",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/api-only.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "start:api": "node --enable-source-maps dist/api-only.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/domain/*.test.ts",
    "commands:deploy": "tsx src/deploy-commands.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
