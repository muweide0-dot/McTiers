# One file per McTiers installation. Keep real values in the hosting provider's
# secret/environment settings where possible. Never commit a filled-in .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a different random value for each installation (at least 32 chars).
API_ADMIN_KEY=

PORT=8080
LOG_LEVEL=info
